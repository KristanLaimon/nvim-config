  "React Error Boundary": {
    "prefix": ["errorboundary", "reb"],
    "body": [
      "import { Component } from 'react';",
      "",
      "export class ErrorBoundary extends Component {",
      "\tstate = { hasError: false, error: null };",
      "",
      "\tstatic getDerivedStateFromError(error) {",
      "\t\treturn { hasError: true, error };",
      "\t}",
      "",
      "\tcomponentDidCatch(error, info) {",
      "\t\tconsole.error('ErrorBoundary caught:', error, info);",
      "\t}",
      "",
      "\trender() {",
      "\t\tif (this.state.hasError) {",
      "\t\t\treturn this.props.fallback || (",
      "\t\t\t\t<div role=\"alert\">",
      "\t\t\t\t\t<h2>Something went wrong.</h2>",
      "\t\t\t\t\t<p>{this.state.error?.message}</p>",
      "\t\t\t\t</div>",
      "\t\t\t);",
      "\t\t}",
      "\t\treturn this.props.children;",
      "\t}",
      "}"
    ],
