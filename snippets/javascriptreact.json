      "",
      "export function ${1:Name}Provider({ children }) {",
      "\tconst [${2:value}, set${2:Value}] = useState(${3:initialValue});",
      "",
      "\treturn (",
      "\t\t<${1:Name}Context.Provider value={{ ${2:value} }}>",
      "\t\t\t{children}",
      "\t\t</${1:Name}Context.Provider>",
      "\t);",
      "}",
      "",
      "export function use${1:Name}() {",
      "\tconst context = useContext(${1:Name}Context);",
      "\tif (!context) {",
      "\t\tthrow new Error('use${1:Name} must be used within a ${1:Name}Provider');",
      "\t}",
      "\treturn context;",
      "}"
    ],
    "description": "Complete React Context with Provider and custom consumption hook"
