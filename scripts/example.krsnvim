-- 🦊 test.krsnvim - krsnvimscript example
local root = vim.fn.stdpath("config")
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" .. package.path
require("krs.lib.krsnvim")

local cli = require("krs.lib.krsnvim.terminal")
local fetch = require("krs.lib.krsnvim.fetch")
local console = require("krs.lib.krsnvim.console")

print("Hello from test.krsnvim script! 🦊")

cli.run("echo Hello from cli commands!")

local res = fetch.get("https://jsonplaceholder.typicode.com/todos/1")
if res.ok then
	console.log("Fetch response:", res:text())
end
